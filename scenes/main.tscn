[gd_scene load_steps=8 format=3]

[ext_resource type="Environment" path="res://materials/environment.tres" id="1_env"]
[ext_resource type="Script" path="res://scripts/warehouse_builder.gd" id="2_builder"]
[ext_resource type="Script" path="res://scripts/grid_manager.gd" id="3_grid"]
[ext_resource type="Script" path="res://scripts/camera_controller.gd" id="4_camera"]
[ext_resource type="Script" path="res://scripts/hud_overlay.gd" id="5_hud"]
[ext_resource type="Script" path="res://scripts/amr/fleet_manager.gd" id="6_fleet"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.06, 0.09, 0.14, 0.88)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.18, 0.26, 0.38, 0.9)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
expand_margin_left = 12.0
expand_margin_top = 8.0
expand_margin_right = 12.0
expand_margin_bottom = 8.0

[node name="Main" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("1_env")

[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.819152, -0.40558, 0.40558, 0, 0.707107, 0.707107, -0.573576, -0.579228, 0.579228, 0, 20, 0)
light_color = Color(0.98, 0.96, 0.92, 1)
light_energy = 1.25
shadow_enabled = true
shadow_bias = 0.03
shadow_blur = 1.5

[node name="Warehouse" type="Node3D" parent="."]
script = ExtResource("2_builder")

[node name="Navigation" type="Node3D" parent="."]

[node name="GridManager" type="Node3D" parent="Navigation"]
script = ExtResource("3_grid")

[node name="Zones" type="Node3D" parent="."]

[node name="AMR_Fleet" type="Node3D" parent="."]
script = ExtResource("6_fleet")

[node name="Simulation" type="Node3D" parent="."]

[node name="CameraPivot" type="Node3D" parent="."]
transform = Transform3D(0.707107, -0.40558, 0.579228, 0, 0.819152, 0.573576, -0.707107, -0.40558, 0.579228, 0, 0, 0)
script = ExtResource("4_camera")

[node name="Camera3D" type="Camera3D" parent="CameraPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 38)
fov = 50.0
near = 0.5
far = 200.0

[node name="UI" type="CanvasLayer" parent="."]

[node name="HUD" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5_hud")

[node name="HeaderPanel" type="PanelContainer" parent="UI/HUD"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 20.0
offset_top = 15.0
offset_right = -20.0
offset_bottom = 65.0
grow_horizontal = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="HBox" type="HBoxContainer" parent="UI/HUD/HeaderPanel"]
layout_mode = 2
alignment = 1
mouse_filter = 2

[node name="Title" type="Label" parent="UI/HUD/HeaderPanel/HBox"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/font_size = 17
text = "  🏭 3D SMART WAREHOUSE DIGITAL TWIN  |  [AMR FLEET INITIALIZED]"
vertical_alignment = 1

[node name="PresetsLabel" type="Label" parent="UI/HUD/HeaderPanel/HBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.5, 0.65, 0.8, 1)
theme_override_font_sizes/font_size = 13
text = "Camera Views: "
vertical_alignment = 1

[node name="BtnOverview" type="Button" parent="UI/HUD/HeaderPanel/HBox"]
layout_mode = 2
focus_mode = 0
text = "[1] Overview"

[node name="BtnTopDown" type="Button" parent="UI/HUD/HeaderPanel/HBox"]
layout_mode = 2
focus_mode = 0
text = "[2] Top-Down"

[node name="BtnPickup" type="Button" parent="UI/HUD/HeaderPanel/HBox"]
layout_mode = 2
focus_mode = 0
text = "[3] Stations"

[node name="BtnCharging" type="Button" parent="UI/HUD/HeaderPanel/HBox"]
layout_mode = 2
focus_mode = 0
text = "[4] Charging Docks"

[node name="InfoPanel" type="PanelContainer" parent="UI/HUD"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -195.0
offset_right = 370.0
offset_bottom = -20.0
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="UI/HUD/InfoPanel"]
layout_mode = 2
mouse_filter = 2

[node name="MetricsTitle" type="Label" parent="UI/HUD/InfoPanel/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.2, 0.8, 1, 1)
theme_override_font_sizes/font_size = 14
text = "📊 WAREHOUSE & FLEET METRICS"

[node name="MetricsText" type="RichTextLabel" parent="UI/HUD/InfoPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_colors/default_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/normal_font_size = 12
bbcode_enabled = true
text = "[color=#64748b]Facility Bounds:[/color] 50m × 40m (2,000 m²)
[color=#64748b]Navigation Graph:[/color] 25 × 20 Grid (500 Cells @ 2.0m)
[color=#64748b]Active Fleet:[/color] 4 Autonomous Mobile Robots (AMR 01–04)
[color=#64748b]AMR Status:[/color] Smooth Waypoint Trajectory & Movement
[color=#64748b]Functional Zones:[/color] Inbound Pickup, Outbound Dropoff
[color=#64748b]Fleet Infrastructure:[/color] 4 Charging Docks, 3 Dock Bays"

[node name="ControlsHint" type="PanelContainer" parent="UI/HUD"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -490.0
offset_top = -55.0
offset_right = -20.0
offset_bottom = -20.0
grow_horizontal = 0
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="HintText" type="Label" parent="UI/HUD/ControlsHint"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.82, 1)
theme_override_font_sizes/font_size = 12
text = "🕹️ WASD / Arrows / Drag: Pan  |  Right/Left Drag: Orbit  |  Wheel: Zoom  |  1-4: Presets"

[connection signal="pressed" from="UI/HUD/HeaderPanel/HBox/BtnOverview" to="UI/HUD" method="_on_overview_btn_pressed"]
[connection signal="pressed" from="UI/HUD/HeaderPanel/HBox/BtnTopDown" to="UI/HUD" method="_on_topdown_btn_pressed"]
[connection signal="pressed" from="UI/HUD/HeaderPanel/HBox/BtnPickup" to="UI/HUD" method="_on_pickup_btn_pressed"]
[connection signal="pressed" from="UI/HUD/HeaderPanel/HBox/BtnCharging" to="UI/HUD" method="_on_charging_btn_pressed"]
